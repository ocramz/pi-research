/> I014_ND = Equivalent to ND but calculated using settlement metered generation data from the I014 file where available <br/><br/> TSD = Demand is equal to the ND plus the additional generation required to meet station load, pump storage pumping and interconnector exports <br/><br/> I014_TSD = Equivalent to TSD (above), but calculated using settlement metered generation data from the I014 file where available", "metadata_modified": "2025-06-20T14:00:53.335248", "cache_last_updated": null, "url": "https://api.neso.energy/dataset/8f2fe0af-871c-488d-8bad-960426f24601/resource/ec63adc8-e8a1-45cc-a593-5953b1ede7b1/download/demanddata_2008.csv", "datastore_active": true, "format": "CSV", "package_id": "8f2fe0af-871c-488d-8bad-960426f24601", "created": "2025-06-20T08:38:21.871433", "state": "active", "mimetype_inner": null, "last_modified": "2025-06-20T08:38:21.660130", "position": 25, "revision_id": "42be8bbe-9524-4ea9-ae19-9d27efc65b4d", "url_type": "upload", "id": "ec63adc8-e8a1-45cc-a593-5953b1ede7b1", "resource_type": null, "size": null}, {"mimetype": null, "cache_url": null, "name": "Historic Demand Data 2026", "hash": "", "description": "Historic electricity demand, interconnector, wind and solar outturn data for 2026. Please find a brief summary of some of the columns in the dataset: <br/><br/> ND = National Demand is the sum of metered generation, but excludes generation required to meet station load, hydro storage pumping and interconnector exports <br/><br/> TSD = Transmission System Demand is equal to the ND plus the additional generation required to meet station load, pump storage pumping and interconnector exports.\r\n\r\n<b> **<span style=\"color: rgb(176,74,42)\">NOTE:</span>** NESO have moved the data source to its new forecast system. We are aware of an issue with missing Scottish transfer data and are looking into a prompt resolution. </b>", "metadata_modified": "2026-09-26T08:20:19.320009", "cache_last_updated": null, "url": "https://api.neso.energy/dataset/8f2fe0af-871c-488d-8bad-960426f24601/resource/8a4a771c-3929-4e56-93ad-cdf13219dea5/download/demanddataupdate_2026.csv", "datastore_active": true, "format": "CSV", "package_id": "8f2fe0af-871c-488d-8bad-960426f24601", "created": "2026-02-02T09:20:13.070018", "state": "active", "mimetype_inner": null, "last_modified": "2026-09-26T08:20:20.358434", "position": 26, "revision_id": "4ed19d09-1eff-4ea5-92f3-4f69a604b0f3", "url_type": "upload", "id": "8a4a771c-3929-4e56-93ad-cdf13219dea5", "resource_type": null, "size": null}], "num_resources": 27, "tags": [{"vocabulary_id": null, "state": "active", "display_name": "Demand", "id": "0c8a21fe-b5ef-44dc-a2d7-18497779c439", "name": "Demand"}, {"vocabulary_id": null, "state": "active", "display_name": "Historic", "id": "a50c72e5-19f7-4a89-86f8-506324948a5e", "name": "Historic"}, {"vocabulary_id": null, "state": "active", "display_name": "Interconnectors", "id": "c96f5580-c2e1-4319-8be1-85910fe907e4", "name": "Interconnectors"}, {"vocabulary_id": null, "state": "active", "display_name": "Outturn", "id": "9250cc29-4c72-438f-a7a7-7d3204853d66", "name": "Outturn"}, {"vocabulary_id": null, "state": "active", "display_name": "Solar", "id": "0fbc0fdc-b88f-4c6a-a585-09b3565c648e", "name": "Solar"}, {"vocabulary_id": null, "state": "active", "display_name": "Subscribable", "id": "fb80a4a5-bda6-4679-9c06-4decec4a0917", "name": "Subscribable"}, {"vocabulary_id": null, "state": "active", "display_name": "Wind", "id": "a3db9c7a-931f-4e5a-a39a-8bed98e50072", "name": "Wind"}], "groups": [], "license_id": "ESO", "relationships_as_subject": [], "organization": {"description": "Forecast and historic data for demand, interconnectors, pump storage, and wind and solar generation.", "created": "2019-10-12T12:18:15.519378", "title": "Demand", "name": "demand", "is_organization": true, "state": "active", "image_url": "2024-09-30-082631.332759Demand.svg", "revision_id": "e72c811e-d6b5-4bae-a648-9ce1ca2d42c8", "type": "organization", "id": "06530e1f-add8-4d55-ae30-6f43366585d0", "approval_status": "approved"}, "name": "historic-demand-data", "isopen": false, "url": "National Energy System Operator", "notes": "This section contains historic electricity demand, interconnector, hydro storage pumping, Non-BM Short Term Operating Reserve (STOR), wind and solar outturn data.\r\n\r\nThis dataset is populated 21 days in arrears.  It also undergoes retrospective corrections to Solar Capacity and Outturn, once new data becomes available.  These corrections may occur several months after the first publication.  Retrospective edits to Demand may occur, which make adjustments for Balancing Services undertaken by NESO.\r\n\r\n<b> **<span style=\"color: rgb(176,74,42)\">NOTE:</span>** NESO is aware of some data quality issues with this dataset and are working to resolve them as soon as possible. </b>", "owner_org": "06530e1f-add8-4d55-ae30-6f43366585d0", "extras": [{"key": "Status", "value": "Live"}], "license_url": "https://www.neso.energy/data-portal/ngeso-open-licence", "title": "Historic Demand Data", "revision_id": "43b8ff54-80b8-40be-b0fd-ef69b170ecc6"}}